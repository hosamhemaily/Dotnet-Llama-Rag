# Copy this file to .env and fill in real values. Never commit the real .env file.
# docker-compose reads this automatically; the .NET API reads the equivalent settings
# from appsettings.json, dotnet user-secrets, or environment variables (see README).

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag

# --- LlamaCloud / LlamaParse ---
# Get a key at https://cloud.llamaindex.ai (Settings -> API Keys).
# NEVER commit a real key. Prefer `dotnet user-secrets` for local development;
# this env var is mainly for docker-compose / CI.
LLAMACLOUD_API_KEY=

# --- Ollama (only needed if overriding the defaults in appsettings.json) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=qwen3:8b
