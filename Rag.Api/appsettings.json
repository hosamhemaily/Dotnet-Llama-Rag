{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rag;Username=rag;Password=rag"
  },

  "LlamaCloud": {
    "BaseUrl": "https://api.cloud.llamaindex.ai",
    "ApiKey": "",
    "ParseTier": "cost_effective",
    "PollIntervalSeconds": 3,
    "MaxPollAttempts": 200
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimension": 768,
    "ChatModel": "qwen3:1.7b",
    "Temperature": 0.1,
    "RequestTimeoutSeconds": 300
  },

  "Chunking": {
    "MaxChunkSizeChars": 1500,
    "OverlapChars": 200
  }
}
